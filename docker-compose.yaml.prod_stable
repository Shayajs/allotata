services:
    # Ton application PHP
    laravel_app:
        container_name: laravel_app
        image: www-app
        restart: unless-stopped
        working_dir: /var/www/html
        volumes:
            - .:/var/www/html
            - ./deploy/production/php-uploads.ini:/usr/local/etc/php/conf.d/uploads.ini
        networks:
            - laravel_net

    # Ta base de données (MySQL 8.0 d'après ton docker ps)
    laravel_db:
        container_name: laravel_db
        image: mysql:8.0
        restart: unless-stopped
        environment:
            MYSQL_DATABASE: ${DB_DATABASE}
            MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
        volumes:
            - laravel_db_data:/var/lib/mysql
        networks:
            - laravel_net

    # Ton serveur Nginx
    laravel_nginx:
        container_name: laravel_nginx
        image: nginx:alpine
        restart: unless-stopped
        volumes:
            - .:/var/www/html
            - ./nginx.conf:/etc/nginx/conf.d/default.conf
        networks:
            - laravel_net

networks:
    laravel_net:
        external: true
        name: www_laravel_net

volumes:
    laravel_db_data:
        external: true
        name: www_laravel_db_data
