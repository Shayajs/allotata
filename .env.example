APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Ne pas definir ASSET_URL avec les sous-domaines : Vite emet des
# <script type="module">, et un module charge depuis une autre origine est refuse
# par le navigateur faute d'en-tetes CORS. Les assets doivent suivre la page.

# Sous-domaines PWA. Les anciens liens de l'apex restent valides mais redirigent.
# Cookie de session partagé obligatoire dès que le flag est on (re-login une fois) :
SUBDOMAIN_ROUTING=true
APP_BASE_DOMAIN=allotata.test
# SESSION_DOMAIN=.allotata.test
# Redirections implicites apex -> sous-domaine (302 en test, 301 quand stabilisé) :
SUBDOMAIN_LEGACY_REDIRECT=true
SUBDOMAIN_REDIRECT_STATUS=302

# Fuseau métier (réservations / agenda) : heures saisies = heure locale France
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.allotata.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# BrightShell mail (lucas.espinar@brightshell.fr) — IMAP + SMTP, module Mail ERP
BRIGHTSHELL_MAIL_HOST=mail.brightshell.fr
BRIGHTSHELL_MAIL_PORT=465
BRIGHTSHELL_MAIL_IMAP_PORT=993
BRIGHTSHELL_MAIL_USERNAME=lucas.espinar@brightshell.fr
BRIGHTSHELL_MAIL_PASSWORD=
BRIGHTSHELL_MAIL_ENCRYPTION=ssl

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Web Push Notifications (VAPID)
# Générer les clés : docker exec laravel_app php -r "require '/var/www/html/vendor/autoload.php'; \$k = Minishlink\WebPush\VAPID::createVapidKeys(); echo \$k['publicKey'].PHP_EOL.\$k['privateKey'].PHP_EOL;"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"

# Récupération d'urgence admin (php artisan emergency:url)
# Générer : php artisan tinker → echo \Illuminate\Support\Str::random(64);
EMERGENCY_RECOVERY_TOKEN=
